# Copy to .env and fill in to enable AI news analysis (uses Claude Haiku — pennies per month)
ANTHROPIC_API_KEY=sk-ant-...

# The Odds API (odds-api.js). Free tier is 500 requests/month, shared across
# NFL and MLB. Leave unset and the app degrades to model-only output.
ODDS_API_KEY=
# Credits to always keep in reserve before a call is allowed (fail-closed guard).
ODDS_API_RESERVE=50

# ParlayAPI (parlay-api.com, parlay-api.js) — a second, independently-metered
# odds feed. Free tier is 1,000 credits/month, no card required, and does not
# share a budget with The Odds API. Sign up at https://parlay-api.com to get a
# key; leave unset and this integration no-ops (existing Odds API behavior is
# unaffected). Setting this key is what lets MLB odds capture in
# mlb-pregame.js run without waiting on The Odds API's monthly reset.
PARLAY_API_KEY=
PARLAY_API_RESERVE=50

# Set to 1 to let MLB odds capture spend from The Odds API's own (shared)
# budget. Off by default since MLB previously drained a month's credits in a
# day; unnecessary if PARLAY_API_KEY is set, since that budget is separate.
MLB_ODDS_CAPTURE=0
