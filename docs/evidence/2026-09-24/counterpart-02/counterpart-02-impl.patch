diff --git a/test/campaign-opponent-model.test.js b/test/campaign-opponent-model.test.js
new file mode 100644
index 00000000..f39fc413
--- /dev/null
+++ b/test/campaign-opponent-model.test.js
@@ -0,0 +1,166 @@
+/**
+ * COUNTERPART-02: the War Room opponent model (server/services/campaign/opponent-model.js)
+ * and its use in the search (search.js). Made-up rows and the made-up four-team league
+ * (test/fixtures/campaign-league.mjs). No DB, no real league data.
+ */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+const M = await import('../server/services/campaign/opponent-model.js');
+const { makeAdapter } = await import('./fixtures/campaign-league.mjs');
+const { planLeague } = await import('../server/services/campaign/planner.js');
+const { normaliseObjective } = await import('../server/services/campaign/objectives.js');
+
+const DAY = 864e5;
+const T0 = Date.UTC(2026, 8, 1);
+const item = (from, to, pid) => ({ type: 'TRADE', fromTeamId: from, toTeamId: to, playerId: pid });
+const proposal = (id, team, at, items, extra = {}) => ({ tx_id: id, type: 'TRADE_PROPOSAL', execution_type: 'EXECUTE', team_id: team,
+  related_tx_id: null, raw: { proposedDate: at, expirationDate: at + 2 * DAY, items }, ...extra });
+const kid = (id, rel, type, team, at, extra = {}) => ({ tx_id: id, type, execution_type: 'EXECUTE', team_id: team, related_tx_id: rel,
+  raw: { proposedDate: at, processDate: at, items: [] }, ...extra });
+const cancel = (id, rel, team, at, member = 'someone') => ({ tx_id: id, type: 'TRADE_PROPOSAL', execution_type: 'CANCEL', team_id: team,
+  related_tx_id: rel, member_id: member, raw: { proposedDate: at, processDate: at, items: [item(1, 2, 9)] } });
+
+function rows() {
+  return [
+    // a: 1 -> 2, accepted
+    proposal('a', 1, T0, [item(1, 2, 10), item(2, 1, 20)]), kid('a1', 'a', 'TRADE_ACCEPT', 2, T0 + 3600e3),
+    // b: 1 -> 3, declined, then 3 sends 1 his own offer the next day (a counter)
+    proposal('b', 1, T0 + DAY, [item(1, 3, 11), item(3, 1, 30)]), kid('b1', 'b', 'TRADE_DECLINE', 3, T0 + DAY + 3600e3),
+    proposal('c', 3, T0 + 2 * DAY, [item(3, 1, 31), item(1, 3, 12)]),
+    // d: 1 -> 4, expired unanswered (the task processor cancels it at expiry)
+    proposal('d', 1, T0 + 3 * DAY, [item(1, 4, 13), item(4, 1, 40)]), cancel('d1', 'd', 1, T0 + 5 * DAY, 'TradeTaskProcessor-x'),
+    // e: 1 -> 2, withdrawn after 10 minutes (an edit, not a reply)
+    proposal('e', 1, T0 + 4 * DAY, [item(1, 2, 14), item(2, 1, 21)]), cancel('e1', 'e', 1, T0 + 4 * DAY + 600e3),
+    // f: the proposal row was never captured; only the decline survived
+    kid('f1', 'f', 'TRADE_DECLINE', 4, T0 + 6 * DAY),
+    // not a trade
+    { tx_id: 'w', type: 'WAIVER', execution_type: 'EXECUTE', team_id: 1, raw: {} },
+  ];
+}
+
+/* ------------------------------------------------------------ offers */
+
+test('offers are classified accept / counter / decline / ignore, with E1\'s decided set', () => {
+  const offers = M.classifyOffers(rows(), { now: T0 + 30 * DAY });
+  const by = Object.fromEntries(offers.map(o => [o.offer_id, o]));
+  assert.equal(by.a.reply, 'accept'); assert.equal(by.a.decided, 1); assert.equal(by.a.receiver, '2');
+  assert.equal(by.b.reply, 'counter', 'a no followed by his own offer back within two days is a counter');
+  assert.equal(by.b.decided, 0);
+  assert.equal(by.d.reply, 'ignore'); assert.equal(by.d.decided, 0, 'expired unanswered counts as a no, as in E1');
+  assert.equal(by.e.reply, null, 'withdrawn inside the edit window says nothing about him');
+  assert.equal(by.e.decided, null);
+  assert.equal(by.f.reply, 'decline'); assert.equal(by.f.receiver, '4'); assert.equal(by.f.items_known, false);
+  assert.equal(by.c.receiver, '1');
+  assert.ok(!by.w);
+});
+
+test('the reply model only learns from replies known before the as-of time', () => {
+  const offers = M.classifyOffers(rows(), { now: T0 + 30 * DAY });
+  const before = M.replyModel(offers, T0 + 1800e3);         // the accept on offer a lands an hour in
+  assert.equal(before.league_n, 0);
+  assert.deepEqual(before.league, M.posterior(M.REPLY_PRIOR, M.PRIOR_STRENGTH, {}));
+  const after = M.replyModel(offers, T0 + 2 * 3600e3);
+  assert.equal(after.league_n, 1);
+  assert.ok(after.byTeam.get('2').reply.accept > after.league.accept, 'his own accept moves him above the league');
+  assert.ok(after.league.accept > M.REPLY_PRIOR.accept);
+  const s = Object.values(after.byTeam.get('2').reply).reduce((a, b) => a + b, 0);
+  assert.ok(Math.abs(s - 1) < 1e-12);
+});
+
+test('with no offers the model is the M6 prior and P(yes | decided) is its accept share of the answers', () => {
+  const r = M.posterior(M.REPLY_PRIOR, M.PRIOR_STRENGTH, {});
+  for (const k of M.REPLY_KINDS) assert.ok(Math.abs(r[k] - M.REPLY_PRIOR[k]) < 1e-12);
+  assert.ok(Math.abs(M.pYesDecided(r) - 0.05 / 0.55) < 1e-12);
+});
+
+/* ------------------------------------------------------------ nick_override */
+
+test('nick_override: active, hard, unreachable and not-trading are read from the profile shape', () => {
+  assert.deepEqual(M.readOverride({ active: true, difficulty: 'hard to deal with' }),
+    { status: 'ok', active: true, exclude: false, deprioritize: false, hard: true, basis: 'nick_override: active, hard' });
+  const away = M.readOverride('{"contactable": false, "note": "unreachable; exclude from plans"}');
+  assert.equal(away.exclude, true); assert.equal(away.active, false);
+  assert.equal(M.readOverride({ buyer: false, trades: 'probably none' }).deprioritize, true);
+  const none = M.readOverride(null);
+  assert.equal(none.status, 'none');
+  const other = M.readOverride({ fan_of: 'a team', note: 'a player is out for the season' });
+  assert.deepEqual([other.active, other.exclude, other.deprioritize, other.hard], [false, false, false, false]);
+});
+
+/* ------------------------------------------------------------ simulated step */
+
+const model = (overrides = {}, wants = new Map(), offers = []) => M.buildOpponentModel({ teams: ['2', '3', '4'], offers,
+  overrides: new Map(Object.entries(overrides)), wants, now: T0 + 30 * DAY });
+
+test('P(yes): clone x deal ratio; exclude -> 0; hard halves the odds; out of the active pool halves it', () => {
+  const m = model({ 2: { active: true }, 3: { active: true, difficulty: 'hard' }, 4: { contactable: false } });
+  const base = { p: 0.4 };
+  const s2 = M.simulateStep(m, '2', base);
+  assert.ok(Math.abs(s2.p - 0.4) < 1e-12, 'no history: his deal rate is the league\'s, so the clone stands');
+  const s3 = M.simulateStep(m, '3', base);
+  assert.ok(Math.abs(s3.p - (0.4 / 0.6 * 0.5) / (1 + 0.4 / 0.6 * 0.5)) < 1e-12);
+  assert.equal(M.simulateStep(m, '4', base).p, 0);
+  const m2 = model({ 2: { active: true } });
+  assert.ok(Math.abs(M.simulateStep(m2, '3', base).p - 0.2) < 1e-12, 'outside the pool');
+  const nopool = model({});
+  assert.ok(Math.abs(M.simulateStep(nopool, '3', base).p - 0.4) < 1e-12, 'no pool named: nobody is outside it');
+  assert.ok(s3.features.every(f => f.fitted === false && f.feature && f.basis));
+});
+
+test('his reply history moves P(yes): a manager who deals rates above the league, one who declines below', () => {
+  const offers = M.classifyOffers(rows(), { now: T0 + 30 * DAY });
+  const m = model({}, new Map(), offers);
+  const p2 = M.simulateStep(m, '2', { p: 0.4 }).p, p4 = M.simulateStep(m, '4', { p: 0.4 }).p;
+  assert.ok(p2 > 0.4, `accepted before: ${p2}`);
+  assert.ok(p4 < 0.4, `ignored and declined before: ${p4}`);
+});
+
+test('wants_player raises the search rank of a step that gives him the player, never P(yes)', () => {
+  const wants = new Map([['3', new Map([['5', { lift: 2.0, n: 4 }]])]]);
+  const m = model({}, wants);
+  assert.equal(M.rankTilt(m, '3', [5]).tilt, 1 + M.WANTS_RANK_TILT);
+  assert.equal(M.rankTilt(m, '3', [4]).tilt, 1);
+  assert.equal(M.rankTilt(m, '2', [5]).tilt, 1);
+  const noWants = model({});
+  assert.equal(M.simulateStep(m, '3', { p: 0.4 }).p, M.simulateStep(noWants, '3', { p: 0.4 }).p);
+});
+
+test('flag: GRIDIRON_OPPONENT_MODEL=1 on; preview turns it on; =0 wins over preview; default off', () => {
+  const prev = process.env.GRIDIRON_PREVIEW_UNCONFIRMED;
+  try {
+    delete process.env.GRIDIRON_PREVIEW_UNCONFIRMED;
+    assert.deepEqual(M.opponentFlag({}), { on: false, preview: false });
+    assert.deepEqual(M.opponentFlag({ GRIDIRON_OPPONENT_MODEL: '1' }), { on: true, preview: false });
+    process.env.GRIDIRON_PREVIEW_UNCONFIRMED = '1';
+    assert.deepEqual(M.opponentFlag({}), { on: true, preview: true });
+    assert.deepEqual(M.opponentFlag({ GRIDIRON_OPPONENT_MODEL: '0' }), { on: false, preview: false });
+  } finally {
+    if (prev == null) delete process.env.GRIDIRON_PREVIEW_UNCONFIRMED; else process.env.GRIDIRON_PREVIEW_UNCONFIRMED = prev;
+  }
+});
+
+/* ------------------------------------------------------------ in the planner */
+
+const plan = adapter => planLeague(adapter, { objective: normaliseObjective({}) });
+const partnersOf = res => res.deck.flatMap(c => c.plan.steps.map(s => String(s.team)));
+
+test('off: the planner is unchanged; the wrapper with a neutral model changes nothing either', () => {
+  const a = plan(makeAdapter()), b = plan(makeAdapter());
+  assert.deepEqual(a.deck.map(c => c.plan), b.deck.map(c => c.plan));
+  const neutral = M.withOpponentModel(makeAdapter(), model({}));
+  const c = plan(neutral);
+  assert.deepEqual(c.deck.map(x => x.plan.steps.map(s => [s.team, s.give, s.get, s.p])), a.deck.map(x => x.plan.steps.map(s => [s.team, s.give, s.get, s.p])));
+});
+
+test('on: an unreachable manager is in no move, and the deck routes through the active pool', () => {
+  const off = plan(makeAdapter());
+  assert.ok(partnersOf(off).includes('3'), 'fixture: team 3 is a partner today');
+  const on = plan(M.withOpponentModel(makeAdapter(), model({ 3: { contactable: false }, 2: { active: true }, 4: { active: true } })));
+  assert.ok(on.deck.length > 0);
+  assert.ok(!partnersOf(on).includes('3'), 'excluded manager in a move');
+  const pool = plan(M.withOpponentModel(makeAdapter(), model({ 4: { active: true } })));
+  const share = ps => ps.filter(t => t === '4').length / ps.length;
+  assert.ok(share(partnersOf(pool)) >= share(partnersOf(off)), 'the pool partner does not lose share');
+  for (const c of pool.deck) for (const s of c.plan.steps) assert.ok(s.p >= 0 && s.p <= M.P_MAX);
+});
