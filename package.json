{
  "name": "fantasy-football-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "install-app": "node scripts/install.mjs",
    "start": "node scripts/start.mjs",
    "build": "vite build --config client/vite.config.ts",
    "test": "node --test --test-concurrency=1 test/*.test.js && npm run test:frontend",
    "test:frontend": "vitest run --config client/vite.config.ts client/src/components/PostDraftPlan.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "start:smoke": "node scripts/start-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run start:smoke",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "sync:data": "node scripts/bootstrap-data.mjs",
    "sync:history": "node server/scripts/sync-history.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:rollback": "node scripts/rollback-migration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
