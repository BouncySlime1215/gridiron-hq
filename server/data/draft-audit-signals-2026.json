 "method": {
  "preseason_rank": "nfl_historical_adp (dynastyprocess_fpecr = FantasyPros expert consensus rank, July-Sept scrape), not true ADP. Overall tier = integer order of ecr_rank within season including K/DST; positional tier = order within position.",
  "actuals": "PPR season points recomputed from nfl_player_week_features (nflverse play-by-play derived, keyed by true gsis_id), weeks 1-18, using server/services/scoring.js PPR weights (0.04/4/-2 pass, 0.1/6 rush, 1/0.1/6 rec). Fumbles lost are not in that table and are omitted (validated: r=0.9987 vs ESPN 2025 actuals, mean diff +0.15 pts; r=0.9999 vs nflverse ffopportunity actual_fantasy_points 2022-2025, MAD 0.85).",
  "why_not_player_week_usage": "player_week_usage is keyed by players.id whose gsis_id crosswalk is corrupted for some rows (e.g. players.id 424 \"Noah Gray\" holds Travis Kelce's gsis 00-0030506; Isiah Pacheco row points at a 2026 rookie), so Kelce/Kamara/Andrews/Murray/Ridley/Pacheco had zero rows under their own ids. Not used.",
  "join": "ECR player_key (normalizePlayerName) matched to gsis via full names in nfl_depth, nfl_injuries, nfl_ffopportunity_weekly, nfl_roster_snapshots; position match; ties broken by nflverse abbreviated name then team. 7 explicit aliases (Marquise/Hollywood Brown, Robby/Robbie Anderson, Ken/Kenneth Walker, Gabriel/Gabe Davis, Kenneth/Kenny Gainwell, Chigoziem/Chig Okonkwo, Joshua/Josh Palmer). Result: 2182 matched, 289 known players with no stat line (scored 0 pts / 0 games; 8 of them inside the top 150, all genuine DNPs), 0 ambiguous, 81 unmatched (all outside the top 150, excluded).",
  "games": "games = weeks with a stat line in nfl_player_week_features (weeks 1-18).",
  "hit": "finish positional rank <= drafted positional rank; hit6 = finish <= drafted + 6.",
  "bust": "finish positional rank >= drafted + 12 (two 6-slot tiers) OR games <= 8.",
  "vorp": "points minus the Nth-best actual finisher at the position that season, N = QB11 / RB27 / WR27 / TE8 (8-team demand). VORP+ = max(0, VORP). Expected VORP+ of a slot = points of the player who actually finished at the drafted positional rank, minus replacement, floored at 0. realized_fraction = sum(VORP+) / sum(expected VORP+) over the cell.",
  "multiplier": "realized_fraction(cell) / pooled realized_fraction (0.946), so the expected-VORP-weighted mean of raw multipliers is 1.0. Null where the slot is at/below replacement (expected VORP+ < 8 per pick): a ratio is meaningless there, use realized_vorp_plus_per_pick instead. Raw ratios outside [0.5, 1.5] are capped and noted.",
  "caveats": [
   "One preseason snapshot (ECR) per season, not the league's own ADP.",
   "n per positional tier = 30 (6 per season x 5); per-season cells are n=6 and are noise.",
   "Hit rate for deep tiers is inflated by construction (many players above them bust), read VORP+ for those tiers.",
   "No fumbles in actuals (~1-4 pts/season for RB/QB)."
  ]
 },
