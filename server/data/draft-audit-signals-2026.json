 "rules": [
  {
   "id": "rb_over_wr_13_36",
   "rule": "In the 13-36 overall ECR range, take the RB over the WR. Applies to picks 2.1-4.8 in an 8-team draft.",
   "evidence": "RBs drafted 13-36 overall realized 88.4/55.5 VORP+ per pick (13-24/25-36) vs WRs 42.9/17.5. Pooled 13-36: RB 72 vs WR 31.6 VORP+ (diff 40.4, SE 11.9, t=3.39). RB won 4 of 5 seasons in each sub-tier; 2022 is the exception in 13-24. Same sign on raw unclipped VORP (t=2.39) and on hit rate (50% vs 20%, t=2.63); points-vs-own-slot is directionally the same but not significant (t=0.9) because WR slots score more in absolute terms.",
   "n": {
    "RB": 42,
    "WR": 54
   },
   "strength": "strong",
   "direction": "RB > WR",
   "replacement": "QB11/RB27/WR27/TE8"
  },
  {
   "id": "rookie_wr_premium",
   "rule": "A rookie WR drafted inside the top 150 is a better bet than a veteran WR at the same ECR slot; lean rookie WR when tied.",
   "evidence": "Rookie WRs (n=28) beat their ECR slot by 16.9 pts on average vs -25.5 for veteran WRs (n=278); diff 42.5, SE 12.4, t=3.41. Hit rate 64% vs 37%, bust 29% vs 44%. Hit rate was >=50% in every season 2021-2025. No equivalent edge for rookie RBs (vs slot +3.2, t=0.2).",
   "n": {
    "rookie_WR": 28,
    "veteran_WR": 278
   },
   "strength": "strong",
   "direction": "rookie WR > veteran WR"
  },
  {
   "id": "te_cliff_after_te8",
   "rule": "In an 8-team league, do not draft a TE ranked TE9 or later expecting starter value, and never roster two TEs early. Pay for TE1-3 or wait for the TE4-8 band.",
   "evidence": "Replacement is TE8 by actual points. TEs drafted TE9-TE24 realized 3.3 VORP+ per pick (n=80); TE4-8 realized 17.1 (n=25) and TE1-3 43.6 (n=15). TE4-8 vs TE9-16: diff 13.9, SE 6.9, t=2.02.",
   "n": {
    "TE1_3": 15,
    "TE4_8": 25,
    "TE9_16": 40
   },
   "strength": "moderate",
   "direction": "TE value collapses after TE8"
  },
  {
   "id": "elite_qb_worth_it_8team",
   "rule": "An elite QB (ECR QB1-QB3) is worth an early-round pick in an 8-team league; QB4-QB10 is not, and the QB11+ band is free.",
   "evidence": "QB1-3 realized 56.4 VORP+ per pick (n=15) vs 23.2 for QB4-10 (n=35); diff 33.2, SE 14.6, t=2.27. QB1-3 (drafted 13-36 overall) matched RBs in the same overall range (56.4 vs 72 VORP+, t=-0.95) and beat WRs there. Only 28% of QB13-24 picks finished above QB11.",
   "n": {
    "QB1_3": 15,
    "QB4_10": 35
   },
   "strength": "moderate (n=15 elite QBs, 5 seasons)",
   "direction": "QB1-3 > QB4-10 ~ 0"
  }
 ],
