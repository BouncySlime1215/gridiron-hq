{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    // WARROOM-LABEL-FIX: the client imports the one pronoun guard, server/services/people/neutral.js
    // (pure, no deps), instead of duplicating it — allowJs lets tsc resolve that single .js import.
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["client/src"]
}
